    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/space_grotesk_medium"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/space_grotesk_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />
</font-family>
