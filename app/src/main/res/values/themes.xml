<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.NumberFacts" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorOnBackground">@color/md_on_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.NumberFacts.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.NumberFacts.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.NumberFacts.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.NumberFacts.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.NumberFacts.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.NumberFacts.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.NumberFacts.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.NumberFacts.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.NumberFacts.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.NumberFacts.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.NumberFacts.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.NumberFacts.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.NumberFacts.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.NumberFacts.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.NumberFacts.LabelSmall</item>
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>

        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.NumberFacts.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.NumberFacts.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.NumberFacts.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.NumberFacts.ExtraLarge</item>
    </style>

    <style name="Theme.NumberFacts" parent="Base.Theme.NumberFacts" />

    <style name="ShapeAppearance.NumberFacts.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.NumberFacts.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.NumberFacts.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.NumberFacts.ExtraLarge" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>

    <!-- Reusable text styles -->
    <style name="TextAppearance.NumberFacts.Eyebrow" parent="TextAppearance.NumberFacts.LabelLarge">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="TextAppearance.NumberFacts.Subject" parent="TextAppearance.NumberFacts.DisplayLarge">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="TextAppearance.NumberFacts.FactBody" parent="TextAppearance.NumberFacts.BodyLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.NumberFacts.SectionTitle" parent="TextAppearance.NumberFacts.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.NumberFacts.CategoryChip" parent="Widget.Material3.Chip.Filter">
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <!-- Text-only chips: all four categories fit on one line on 360dp phones at normal size. -->
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
    </style>
    <!-- Settings rows -->
    <style name="Widget.NumberFacts.SettingsHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">@dimen/screen_gutter</item>
        <item name="android:paddingEnd">@dimen/screen_gutter</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
    <style name="Widget.NumberFacts.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/screen_gutter</item>
        <item name="android:paddingEnd">@dimen/screen_gutter</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Widget.NumberFacts.SettingsIcon" parent="">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="Widget.NumberFacts.SettingsTexts" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Widget.NumberFacts.SettingsTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="Widget.NumberFacts.SettingsSummary" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
