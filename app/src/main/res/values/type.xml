<?xml version="1.0" encoding="utf-8"?>
<!--
  Type scale. Space Grotesk (medium) carries numbers, screen titles and headlines;
  Manrope carries reading text (regular) and interactive labels (semibold).
  All sizes are in sp so they follow the system font size setting.
-->
<resources>
    <!-- Display and headline: Space Grotesk -->
    <style name="TextAppearance.NumberFacts.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.NumberFacts.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.NumberFacts.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>
    <style name="TextAppearance.NumberFacts.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>
    <style name="TextAppearance.NumberFacts.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>
    <style name="TextAppearance.NumberFacts.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>
    <style name="TextAppearance.NumberFacts.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFamily">@font/space_grotesk</item>
    </style>

    <!-- Titles, body and labels: Manrope -->
    <style name="TextAppearance.NumberFacts.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.NumberFacts.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.NumberFacts.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>
    <style name="TextAppearance.NumberFacts.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>
    <style name="TextAppearance.NumberFacts.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
    </style>
    <style name="TextAppearance.NumberFacts.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.NumberFacts.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.NumberFacts.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/manrope</item>
        <item name="android:fontFamily">@font/manrope</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
